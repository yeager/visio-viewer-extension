{
  "manifest_version": 3,
  "name": "__MSG_extName__",
  "version": "2.0.2",
  "description": "__MSG_extDescription__",
  "default_locale": "en",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": [
    "downloads",
    "webNavigation"
  ],
  "host_permissions": [
    "file:///*",
    "<all_urls>"
  ]
}
